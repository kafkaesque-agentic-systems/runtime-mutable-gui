{
  "version": 1,
  "slug": "runtime-mutable-gui",
  "adapter": "claude",
  "profile": "claude",
  "model": "",
  "agents": {
    "engineer": "runtime-mutable-gui-engineer",
    "reviewer": "runtime-mutable-gui-reviewer",
    "diagnostic": "runtime-mutable-gui-diagnostic"
  },
  "phase_gate": [
    "cargo fmt --all -- --check",
    "cargo clippy --workspace --all-targets -- -D warnings",
    "cargo test --workspace",
    "python3 tools/check-stack.py"
  ],
  "scope_allow": [
    "Cargo.lock",
    "*.new.png",
    "*.diff.png"
  ],
  "environment_check": "test ! -f tools/check-env.sh || sh tools/check-env.sh",
  "seam_gate": [
    "cargo test --workspace --release perf_",
    "cargo xtask bundle mutable-gui-reference --release",
    "sh tools/validate-clap.sh"
  ],
  "phase_gate_ignore": [
    "docs/",
    "DEV_PLAN.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "whole_suite": {
    "crates/mutable-gui-nice/src/": "cargo test -p mutable-gui-nice"
  }
}
